# MarketMate AI — environment variables
# Copy this file to .env.local for local development. Never commit .env.local.

# Which inference adapter to use: "backboard" (default) or "openai_compatible"
AI_PROVIDER=backboard

# Open-weight model identifier (Apache-2.0 weights). Swappable without code changes.
AI_MODEL=openai/gpt-oss-20b

# Vision model for the photo-describe step (must accept image input).
# Default on Groq's free tier: qwen/qwen3.8-27b (1 photo = 2048 tokens).
AI_VISION_MODEL=qwen/qwen3.8-27b

# --- Option A: Backboard API (routes to the model via OpenRouter) ---
BACKBOARD_API_KEY=your_backboard_api_key_here

# --- Option B: any OpenAI-compatible endpoint (Groq, Together, OpenRouter, self-hosted vLLM/Ollama) ---
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=your_provider_api_key_here

# Request timeout for the model call, in milliseconds
AI_TIMEOUT_MS=20000

# Simple per-IP rate limit for /api/generate and /api/describe
RATE_LIMIT_PER_MINUTE=10
